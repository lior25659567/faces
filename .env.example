# Copy to .env and fill in to turn on the page's "3D style" switch.
# Free Cloudflare account -> Workers AI -> "Use REST API" gives both values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional. The default 4B image model allows about 50 free restyles a day.
# The 9B model allows about 7.
# RESTYLE_MODEL=@cf/black-forest-labs/flux-2-klein-9b
